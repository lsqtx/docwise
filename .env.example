# 复制本文件为 .env 后填写需要的密钥，应用会自动读取。
# 只需要配置你实际使用的那个服务，其余留空即可。

# DeepSeek 深度求索 https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 阿里云百炼（通义千问） https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# 智谱 GLM https://open.bigmodel.cn
ZHIPUAI_API_KEY=

# 月之暗面 Kimi https://platform.moonshot.cn
MOONSHOT_API_KEY=

# 任意 OpenAI 兼容服务
OPENAI_API_KEY=

# 本地 Ollama 服务地址，使用离线模型时生效
OLLAMA_BASE_URL=http://localhost:11434
